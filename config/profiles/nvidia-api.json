{
  "name": "nvidia-api",
  "description": "NVIDIA Build Magpie multilingual TTS with explicit Mandarin pinyin frontend.",
  "env": {
    "TTS_PROVIDER": "nvidia",
    "TTS_PROVIDER_FALLBACK": "f5",
    "TTS_LOCK_IDENTITY": "1",
    "TTS_EXPECTED_PROVIDER": "nvidia",
    "TTS_EXPECTED_VOICE": "Magpie-Multilingual.ZH-CN.Siwei",
    "TTS_EXPECTED_RATE": "1.5",
    "TTS_EXPECTED_RATE_TOLERANCE": "0.02",
    "NVIDIA_TTS_VOICE": "Magpie-Multilingual.ZH-CN.Siwei",
    "NVIDIA_TTS_TRANSPORT": "grpc",
    "NVIDIA_TTS_SPEED": "1.5",
    "TTS_FAIL_FAST": "1",
    "NVIDIA_TTS_CONCURRENCY": "1",
    "VIDEO_RENDER_ENGINE": "html-video",
    "HTML_RENDER_CONCURRENCY": "2",
    "HTML_RENDER_PRESET": "veryfast",
    "QUALITY_GATE_PROFILE": "balanced"
  },
  "doctor": { "requireApi": true, "requireBrowser": true }
}
